
# Archivo solo incluido en development debido a información sensible.

# Información de la aplicación
APP_NAME=WSI Visualization API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=True

# API
API_HOST=0.0.0.0
API_PORT=8000

# BD
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wsi_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=wsi_db

# Logging
LOG_LEVEL=INFO

# Uploads - Configuración para imágenes WSI grandes
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10737418240  # 10GB en bytes
CHUNK_SIZE=8388608  # 8MB chunks para streaming eficiente
