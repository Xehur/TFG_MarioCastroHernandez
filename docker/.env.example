# Plantilla de `.env` (en esta misma carpeta docker). Los scripts iniciar.ps1 /
# iniciar.sh crean `.env` a partir de este archivo y generan DB_PASSWORD y
# SECRET_KEY aleatorias. Si lo creas a mano, copialo y rellena esos dos valores.
# docker compose lee automaticamente el archivo .env de esta carpeta.

# --- Base de datos PostgreSQL ---
DB_USER=postgres
# Obligatoria. No uses valores triviales (1234, postgres...): el backend no arrancara.
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=wsi_db

# --- Seguridad del backend (JWT) ---
# Obligatoria, minimo 32 caracteres aleatorios. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend ---
# URL del backend accesible DESDE EL NAVEGADOR del usuario.
# Si accedes por localhost, dejalo asi. Si sirves en otra maquina/IP,
# ponlo a http://IP_DEL_SERVIDOR:8000 y reconstruye el frontend.
VITE_API_BASE_URL=http://localhost:8000

# --- CORS ---
# Origen(es) desde los que se sirve el frontend, en formato JSON.
# Debe coincidir con la URL con la que el usuario abre la aplicacion.
CORS_ORIGINS=["http://localhost:5173"]

# --- IA (InceptionV3) ---
# Donde se ejecuta la IA se elige al montar la app (iniciar.ps1 / iniciar.sh o
# los ficheros docker-compose.gpu-*.yml). Estas variables son opcionales:
# AI_DEVICE=cpu            # solo con la variante CPU: cpu | auto
# AI_BATCH_SIZE=32         # campos por lote en GPU (por defecto 32; en CPU 16)
# TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu126   # variante NVIDIA
# TORCH_ROCM_INDEX_URL=https://download.pytorch.org/whl/rocm7.1 # variante AMD
# De donde descargan los scripts iniciar los pesos del modelo si faltan
# (por defecto, el ultimo release del repositorio en GitHub):
# INCEPTION_WEIGHTS_URL=https://github.com/Xehur/TFG_MarioCastroHernandez/releases/latest/download/HE_inceptionv3.pth
