# Copia este archivo a `.env` (en esta misma carpeta docker) y ajusta los valores.
# docker compose lee automaticamente el archivo .env de esta carpeta.

# --- Base de datos PostgreSQL ---
DB_USER=postgres
# Obligatoria. No uses valores triviales (1234, postgres...): el backend no arrancara.
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=wsi_db

# --- Seguridad del backend (JWT) ---
# Obligatoria, minimo 32 caracteres aleatorios. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend ---
# URL del backend accesible DESDE EL NAVEGADOR del usuario.
# Si accedes por localhost, dejalo asi. Si sirves en otra maquina/IP,
# ponlo a http://IP_DEL_SERVIDOR:8000 y reconstruye el frontend.
VITE_API_BASE_URL=http://localhost:8000

# --- CORS ---
# Origen(es) desde los que se sirve el frontend, en formato JSON.
# Debe coincidir con la URL con la que el usuario abre la aplicacion.
CORS_ORIGINS=["http://localhost:5173"]
